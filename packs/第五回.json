  "人物事蹟": [
    {
      "姓名": "劉備",
      "事蹟": "隨公孫瓚參加討董聯軍；與關羽、張飛三戰呂布，以雙股劍助戰。"
    },
    {
      "姓名": "關羽",
      "事蹟": "以馬弓手身分請戰，溫酒斬華雄，其酒尚溫；又與張飛夾攻呂布。"
    },
